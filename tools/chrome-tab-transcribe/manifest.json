{
  "manifest_version": 3,
  "name": "WhisprRT 多页签听写",
  "version": "1.0.0",
  "description": "分别捕获多个 Chrome 页签音频，推送到本机 WhisprRT 实时出字",
  "permissions": [
    "tabs",
    "tabCapture",
    "offscreen",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "http://127.0.0.1:5444/*",
    "http://localhost:5444/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhisprRT 多页签听写",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
